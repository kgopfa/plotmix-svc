# JWT Configuration
# Internal JWT secret for backend operations (should be different from NextAuth)
JWT_SECRET=your-internal-jwt-secret-key-change-this-in-production-minimum-32-characters
JWT_EXPIRES_IN=24h

# NextAuth Configuration
# NextAuth secret for validating frontend tokens (should match frontend NEXTAUTH_SECRET)
# If not provided, falls back to JWT_SECRET for backward compatibility
NEXTAUTH_SECRET=your-nextauth-secret-key-change-this-in-production-minimum-32-characters

# Internal API Configuration
# Internal API key for secure backend-to-backend communication
INTERNAL_API_KEY=your-secure-internal-api-key-here-minimum-32-characters

# Server Configuration
NODE_ENV=development
PORT=3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Database (when you implement a real database)
# DATABASE_URL="postgresql://username:password@localhost:5432/plotmix"

# LLM Provider and Model Configuration
# Choose provider: openai | anthropic (defaults to openai if absent)
# LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# Pipeline Generation (new chained approach)
GEN_CHAINED=1

# Pipeline model overrides (optional)
PIPELINE_INTENT_REDUCER_MODEL=gpt-4
PIPELINE_ROUTER_MODEL=gpt-3.5-turbo
PIPELINE_SCENE_PLANNER_MODEL=gpt-4
PIPELINE_PER_SCENE_FAN_OUT_MODEL=gpt-4
PIPELINE_SCENE_PROCESSOR_MODEL=gpt-4
PIPELINE_LAYOUT_COMPILER_MODEL=gpt-4

# Anthropic (only required if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
# Optional override (defaults to https://api.anthropic.com/v1/)
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
# Optional version header (defaults to 2023-06-01)
# ANTHROPIC_VERSION=2023-06-01

# Rendering (Puppeteer → ffmpeg)
# Secret used to sign short‑lived render tokens; must match the UI's env
RENDER_TOKEN_SECRET=change_me_generate_a_strong_value
# Base URL of the UI used by the renderer to open the render page (required)
UI_BASE_URL=http://localhost:3000
# Local path to write rendered videos before upload
RENDER_OUTPUT_DIR=/tmp
# Optional ffmpeg encoder controls (libx264 by default)
# RENDER_ENCODER=libx264
# RENDER_VAAPI_DEVICE=/dev/dri/renderD128

# Cloudflare R2 (S3-compatible) Storage (required for uploads)
# The renderer requires R2 to be configured; no local fallback.
# Either set R2_ENDPOINT explicitly or set R2_ACCOUNT_ID to build the endpoint automatically
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: prefix inside the bucket, e.g., 'renders/' (default: renders/)
R2_PREFIX=renders/
# Optional: public base URL (e.g., CDN) to build returned links
R2_PUBLIC_BASE=
# Optional: explicit public endpoint (if different from R2_ENDPOINT)
R2_PUBLIC_ENDPOINT=

# Queue/Worker (BullMQ)
# Provide either REDIS_URL or explicit host config below. Authentication may be required by your provider.
# REDIS_HOST=
# REDIS_PORT=
# REDIS_USERNAME=default
# REDIS_PASSWORD=
# REDIS_TLS=true