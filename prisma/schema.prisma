generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  conversations  Conversation[]  @relation("UserConversations")
  messages       Message[]       @relation("MessageAuthor")
  projectChanges ProjectChange[] @relation("ChangeAuthor")
  projectRoles   ProjectRole[]
  ownedProjects  Project[]       @relation("ProjectOwner")

  @@map("users")
}

model Project {
  id            String          @id @default(cuid())
  name          String
  mainState     Json            // Canvas state: elements, groups, animations, timeline data
  configuration Json?           // UI configuration: resolution, selected shapes, panel states, etc.
  version       String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  userId        String          @map("user_id")
  features      Json?
  description   String?
  source        String?
  title         String?
  conversation  Conversation?   @relation("ProjectConversation")
  changes       ProjectChange[]
  collaborators ProjectRole[]
  owner         User            @relation("ProjectOwner", fields: [userId], references: [id], onDelete: Cascade)
  snapshots     Snapshot[]

  @@map("projects")
}

model Conversation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String    @map("user_id")
  projectId String?   @unique @map("project_id")
  project   Project?  @relation("ProjectConversation", fields: [projectId], references: [id])
  user      User      @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  content        String
  messageType    String       @map("message_type")
  metadata       Json?
  attachments    Json?
  options        Json?
  createdAt      DateTime     @default(now())
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation("MessageAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model ProjectChange {
  id                String   @id @default(cuid())
  version           String
  diff              Json
  actionDescription String?
  clientHash        String?
  createdAt         DateTime @default(now())
  projectId         String   @map("project_id")
  authorUserId      String   @map("author_user_id")
  author            User     @relation("ChangeAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_changes")
}

model Snapshot {
  id        String   @id @default(cuid())
  version   String
  state     Json
  createdAt DateTime @default(now())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("snapshots")
}

model ProjectRole {
  id        String  @id @default(cuid())
  role      String
  status    String
  projectId String  @map("project_id")
  userId    String  @map("user_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_roles")
}
